{
  "name": "mypi-wire-trim",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "pi extension: stop re-uploading historical chain-of-thought. Trims reasoning fields from the outbound payload.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/wire-trim/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test 'extensions/**/*.test.ts'",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xianxianxianyu/myPi-wire-trim.git"
  },
  "files": [
    "extensions",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
